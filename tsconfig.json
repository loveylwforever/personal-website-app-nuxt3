{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["nuxt", "@element-plus/nuxt", "@pinia/nuxt"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "paths": {
      "pinia": ["./node_modules/pinia"],
      "~/*": ["./*"],
      "@/*": ["./*"],
      "#app": ["./.nuxt/types/app.d.ts"]
    }
  }
}
